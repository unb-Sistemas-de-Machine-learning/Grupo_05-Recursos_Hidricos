# =========================================
# Flask
# =========================================
FLASK_APP=app.py
FLASK_ENV=development

# Porta (deixe 3001 para casar com NEXT_PUBLIC_API_URL=http://localhost:3001)
PORT=3001

# =========================================
# Banco de Dados
# - Use o mesmo arquivo para o app e para o ingestor
# =========================================
DATABASE_PATH=app.db
HIDRO_SQLITE_PATH=app.db   # mantenha igual ao DATABASE_PATH

# =========================================
# Segurança (trocar em produção!)
# =========================================
SECRET_KEY=change-this-in-production
JWT_SECRET_KEY=change-this-too
JWT_ACCESS_TOKEN_EXPIRES=3600        # 1 hora (segundos)
JWT_REFRESH_TOKEN_EXPIRES=2592000    # 30 dias (segundos)

# =========================================
# Uploads (avatars) — usado pelo app.py
# =========================================
MAX_AVATAR_MB=5

# =========================================
# CORS
# =========================================
CORS_ORIGINS=*

# =========================================
# HidroWeb / ANA (NÃO COMITAR .env REAL)
# =========================================
HIDRO_IDENTIFICADOR=   # seu CPF/CNPJ cadastrado na API
HIDRO_SENHA=           # sua senha da API
HIDRO_BASE_URL=https://www.ana.gov.br/hidrowebservice/EstacoesTelemetricas
HIDRO_INGEST_SLEEP=0.4 # pausa entre janelas (segundos) — seja conservador

# =========================================
# Admin seed (opcional, para flask seed-admin)
# =========================================
ADMIN_EMAIL=admin@admin.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=Admin123!
