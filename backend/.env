# =========================================
# Flask
# =========================================
FLASK_APP=app.py
FLASK_ENV=development

# Porta (casar com NEXT_PUBLIC_API_URL=http://localhost:3001)
PORT=3001

# =========================================
# Banco de Dados
# =========================================
DATABASE_PATH=app.db
HIDRO_SQLITE_PATH=app.db

# =========================================
# Segurança (trocar em produção!)
# =========================================
SECRET_KEY=change-this-in-production
JWT_SECRET_KEY=change-this-too
JWT_ACCESS_TOKEN_EXPIRES=3600        # 1 hora (segundos)
JWT_REFRESH_TOKEN_EXPIRES=2592000    # 30 dias (segundos)

# =========================================
# Uploads (avatars)
# =========================================
MAX_AVATAR_MB=5

# =========================================
# CORS
# =========================================
CORS_ORIGINS=*

# =========================================
# HidroWeb / ANA (NÃO COMITAR .env REAL)
# =========================================
HIDRO_IDENTIFICADOR=70843816198 # <- preencha com seu CPF/CNPJ da API
HIDRO_SENHA=c2v3mxwz         # <- preencha com sua senha da API
HIDRO_BASE_URL=https://www.ana.gov.br/hidrowebservice
HIDRO_INGEST_SLEEP=0.4

# =========================================
# Admin seed (opcional, para `flask seed-admin`)
# =========================================
ADMIN_EMAIL=admin@admin.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=Admin123!
